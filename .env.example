# Machine inventory (JSON array). Each entry:
# { "id": "...", "name": "...", "os": "linux|macos|windows|other", "role": "personal|work|shared", "host": "...", "owner": "...", "tags": ["..."] }
MACHINES_JSON='[{"id":"machine-a","name":"Machine A","os":"linux","role":"personal","host":"localhost","owner":"you","tags":["dev"]}]'

# Default machine id used by the CLI when none is given
DEFAULT_MACHINE=machine-a

# Web server
PORT=7778
HOST=127.0.0.1
