# Machine inventory (JSON array). Each entry:
# { "id": "...", "name": "...", "os": "linux|macos|windows|other", "role": "personal|work|shared", "host": "...", "owner": "...", "tags": ["..."], "preferences": { "personal": "~/dev", "work": "~/dev/hubton" } }
MACHINES_JSON='[{"id":"machine-a","name":"Machine A","os":"linux","role":"personal","host":"localhost","owner":"you","tags":["dev"],"preferences":{"personal":"~/dev"}}]'

# Default machine id used by the CLI when none is given
DEFAULT_MACHINE=machine-a

# Optional separate preferences map (machine id -> preferences). Merged with embedded preferences.
# PREFERENCES_JSON='{"machine-a":{"personal":"~/dev"}}'

# Optional path to a preferences JSON file (used by `machines prefs set`)
# PREFERENCES_FILE=~/.config/machines/preferences.json

# Web server
PORT=7778
HOST=127.0.0.1
